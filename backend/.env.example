# Jobless Simulator backend environment template
#
# Copy this file to backend/.env, then replace placeholders with the team's
# development values. Keep backend/.env private and never commit credentials.
# The backend command in docs/README.md loads it with --env-file .env.

# Application
APP_ENV=development
AUTH_ALLOW_UNVERIFIED_TOKENS=false

# Supabase / PostgreSQL
# Copy the exact PostgreSQL URI from the team's Supabase Connect panel. Do not
# hand-edit the host or assume a pooler hostname; the URI must target the
# development project used by the team.
DATABASE_URL=postgresql://postgres:<password>@<supabase-connect-host>:5432/postgres
# Keep this URL identical to frontend/.env.local's VITE_SUPABASE_URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Only needed for a legacy Supabase project that still signs tokens with a
# shared HS256 secret. Leave unset when the project's JWKS endpoint is used.
# SUPABASE_JWT_SECRET=

# MongoDB
# Replace with the team's actual connection URI. The format is intentionally
# generic because the configured provider (local or hosted) is team-owned.
MONGODB_URI=mongodb://<team-mongodb-host>:27017
MONGODB_DATABASE=jobless_simulator

# Optional UUIDs for trusted backend administration. Leave empty unless an
# approved backend flow needs it; never put emails or frontend values here.
# BACKEND_ADMIN_USER_IDS=

# Database integration tests must use a disposable database, never the team's
# Supabase development project. Leave this unset in the copied .env file and
# run backend/scripts/run_disposable_db_tests.sh to provision and tear down a
# temporary PostgreSQL container for the integration suite.
# TEST_DATABASE_URL=
