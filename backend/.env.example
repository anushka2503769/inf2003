# Jobless Simulator backend environment template
#
# The API health route runs without environment variables, but protected profile
# routes need SUPABASE_URL (or the development-only bypass below) to verify tokens.
# Copy this file to backend/.env and replace placeholders locally. Never commit
# backend/.env or share real secret values.

# Application
APP_ENV=development

# Supabase / PostgreSQL
# DATABASE_URL holds student profiles, the canonical skills table and the
# cross-store parent checks. Without it profiles are kept in memory and lost on
# restart, which is fine for a teammate with no database and refused outright
# when APP_ENV=production. Take the connection string from the Supabase
# dashboard's Connect panel; prefer the pooler URI it marks IPv4-compatible.
# Left commented on purpose: an unset value falls back to memory, while a
# placeholder host makes every request fail to connect.
# DATABASE_URL=postgresql://postgres:replace_me@db.your-project.supabase.co:5432/postgres
# SUPABASE_URL is also how the API verifies sign-in tokens: it fetches the
# project's public keys from {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Only for Supabase projects still using the legacy shared HS256 secret. Leave
# unset when SUPABASE_URL is set; asymmetric keys are the default now.
# SUPABASE_JWT_SECRET=

# Optional for trusted backend administration and ingestion only. This key
# bypasses Row Level Security, so leave it unset until an approved backend flow
# requires it. It must never appear in frontend/ or any VITE_* variable.
# SUPABASE_SECRET_KEY=sb_secret_replace_me

# MongoDB
# Replace this local URI with the team's MongoDB connection string when chosen.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=jobless_simulator

# Comma-separated UUIDs authorized for global administrative operations. Empty
# means deny by default; never put email addresses or frontend values here.
# BACKEND_ADMIN_USER_IDS=

# Add provider-specific job API and LLM variables only after those providers
# are selected. Use their actual documented names instead of generic secrets.

# Tests only, and deliberately not DATABASE_URL. tests/test_sql_profile.py runs
# against a real database and truncates public.users and the rows referencing
# it between tests, so this must point at a throwaway database you are willing
# to lose. Never the team's Supabase project. Unset means those tests skip,
# which is how CI runs them.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/jobless_simulator_test

# Development only. Accepts sign-in tokens without checking their signature so
# the API can be exercised before the Supabase project exists. The application
# refuses to start with this set and APP_ENV=production. Never set it on a
# deployed instance or on a branch you intend to merge.
# AUTH_ALLOW_UNVERIFIED_TOKENS=true
