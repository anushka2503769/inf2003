# Jobless Simulator backend environment template
#
# The current health-check skeleton runs without environment variables.
# Copy this file to backend/.env when database integration begins, then replace
# placeholders locally. Never commit backend/.env or share real secret values.

# Application
APP_ENV=development

# Supabase / PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional for trusted backend administration and ingestion only. This key
# bypasses Row Level Security, so leave it unset until an approved backend flow
# requires it. It must never appear in frontend/ or any VITE_* variable.
# SUPABASE_SECRET_KEY=sb_secret_replace_me

# MongoDB
# Replace this local URI with the team's MongoDB connection string when chosen.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=jobless_simulator

# Add provider-specific job API and LLM variables only after those providers
# are selected. Use their actual documented names instead of generic secrets.
