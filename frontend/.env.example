# Jobless Simulator frontend environment template
#
# Copy this file to frontend/.env.local and replace the placeholders with the
# team's Supabase project values. VITE_* values are public in the browser.
# Never put database credentials or Supabase secret keys in this file.

# Use the same project URL as backend/.env's SUPABASE_URL.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable (browser-safe) key.
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# Optional. Leave unset to use the Vite /api proxy to the local backend.
# VITE_API_BASE_URL=/api
