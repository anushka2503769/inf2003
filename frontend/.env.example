# Jobless Simulator frontend environment template
#
# Copy this file to frontend/.env.local (git ignores it) and fill in the two
# Supabase values below. Restart `npm run dev` after editing it.
#
# Both values end up in the browser, so they are public by design. Never put a
# Supabase secret key (sb_secret_... or the legacy service_role key), a database
# password or a MongoDB URI here; those belong only in backend/.env.
#
# Where to find them: Supabase dashboard -> the team's development project.

# Project URL. Dashboard: Project Settings -> Data API -> Project URL
# (also in the "Connect" dialog). It is the same value as SUPABASE_URL in
# backend/.env, so copying it from there is fine.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key. Dashboard: Project Settings -> API Keys -> Publishable key
# (starts with sb_publishable_). If the project only shows legacy keys, use the
# "anon" "public" key from the "Legacy API Keys" tab instead.
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# Optional. Set to mock to show synthetic Discover, Vault and Skill Gap data
# without the backend's job data (demos, design QA). Leave unset for the real API.
# VITE_DATA=mock

# Optional. Leave unset to use the Vite /api proxy to the local backend on
# 127.0.0.1:8000 (see vite.config.ts).
# VITE_API_BASE_URL=/api
