# Jobless Simulator frontend environment template
#
# Copy to frontend/.env.local and fill in the values from the team's Supabase
# project. Git ignores .env.local.
#
# Everything with a VITE_ prefix is compiled into the JavaScript bundle and is
# readable by anyone using the site. Only publishable values belong here.
# The Supabase secret key and all database credentials stay in backend/.env.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable (anon) key. Safe to ship to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Leave unset in development so the Vite proxy forwards /api to the
# backend on port 8000 and no CORS configuration is needed.
# VITE_API_BASE_URL=/api
